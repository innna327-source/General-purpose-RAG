# Copy this file to .env and fill in your own values.
# The app supports any OpenAI-compatible chat completions endpoint.

# OpenAI-compatible LLM
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
GENERATION_LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Optional: use a local Ollama-compatible endpoint
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# GENERATION_LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# Optional: Hugging Face mirror or offline mode
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=0
# TRANSFORMERS_OFFLINE=0

# Optional: reranker and graph store
# RAG_USE_RERANK=true
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_GRAPH_STORE=json

# Optional: Neo4j graph store. Set RAG_GRAPH_STORE=neo4j to enable.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me
# NEO4J_DATABASE=neo4j
